# MongoDB connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pokemondraft?retryWrites=true&w=majority

# Server port (Socket.IO backend)
PORT=4000

# React dev server will use port 3000 by default
# Socket URL for client to connect to backend
REACT_APP_SOCKET_URL=http://localhost:4000

# JWT Secret for authentication tokens (generate a strong random string)
JWT_SECRET=your-secret-key-here
